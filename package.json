{
	"name": "@e280/authlocal",
	"version": "0.3.0-0",
	"description": "user-sovereign login system for everybody",
	"license": "MIT",
	"main": "./x/index.js",
	"type": "module",
	"files": [
		"x",
		"s"
	],
	"exports": {
		".": "./x/index.js",
		"./lib": "./x/lib/index.js"
	},
	"scripts": {
		"build": "rm -rf x && mkdir x && tsc && ln -s \"$(realpath s)\" x/s && npm run check -s",
		"check": "tsc && scute -v",
		"dev": "octo 'node --watch x/test.js' 'tsc -w' 'scute -vw' 'node --watch x/lib/ergo/examples.js' 'hottie x'",
		"test": "node x/test.js",
		"count": "find s -path '*/_archive' -prune -o -name '*.ts' -exec wc -l {} +",
		"address": "node x/lib/ergo/examples.js"
	},
	"dependencies": {
		"@e280/kv": "^0.1.2",
		"@e280/renraku": "^0.5.7",
		"@e280/shiny": "^0.1.0-20",
		"@e280/sly": "^0.3.2",
		"@e280/strata": "^0.3.2",
		"@e280/stz": "^0.2.29",
		"@noble/ciphers": "^2.1.1",
		"@noble/curves": "^2.0.1",
		"@noble/hashes": "^2.0.1",
		"lit": "^3.3.2"
	},
	"devDependencies": {
		"@e280/hottie": "^0.1.0",
		"@e280/octo": "^0.1.0",
		"@e280/science": "^0.1.10",
		"@e280/scute": "^0.3.1",
		"http-server": "^14.1.1",
		"npm-run-all": "^4.1.5",
		"typescript": "^6.0.2"
	},
	"author": "Chase Moskal <chasemoskal@gmail.com>",
	"homepage": "https://github.com/e280/authlocal#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/e280/authlocal.git"
	},
	"bugs": {
		"url": "https://github.com/e280/authlocal/issues"
	},
	"keywords": [
		"auth",
		"authentication",
		"zero-cost",
		"privacy-focused",
		"user-sovereign",
		"clientside",
		"federated",
		"decentralized",
		"protocol",
		"free",
		"open-source"
	]
}
