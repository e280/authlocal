{
	"name": "@e280/authlocal",
	"version": "0.3.0-0",
	"description": "User-sovereign login system for everybody",
	"license": "MIT",
	"main": "./x/exports.web.js",
	"type": "module",
	"files": [
		"x",
		"s"
	],
	"exports": {
		".": "./x/index.js",
		"./core": "./x/core/index.js",
		"./core/alco": "./x/core/alco/index.js",
		"./core/cryp": "./x/core/cryp/index.js",
		"./core/nomen": "./x/core/nomen/index.js",
		"./core/tok": "./x/core/tok/index.js"
	},
	"dependencies": {
		"@e280/kv": "^0.1.0",
		"@e280/renraku": "^0.5.6",
		"@e280/sly": "^0.3.0-7",
		"@e280/strata": "^0.3.0-1",
		"@e280/stz": "^0.2.24",
		"@noble/ciphers": "^2.1.1",
		"@noble/curves": "^2.0.1",
		"@noble/ed25519": "^3.0.0",
		"@noble/hashes": "^2.0.1",
		"lit": "^3.3.2"
	},
	"devDependencies": {
		"@e280/science": "^0.1.8",
		"@e280/scute": "^0.2.2",
		"http-server": "^14.1.1",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.3"
	},
	"scripts": {
		"build": "rm -rf x && mkdir x && run-s _tsc _ln _scute",
		"test": "node x/tests.test.js",
		"start": "octo 'scute -vw' 'node --watch x/tests.test.js' 'tsc -w' 'http-server x'",
		"count": "find s -path '*/_archive' -prune -o -name '*.ts' -exec wc -l {} +",
		"devlinks": "run-s _dl:slate _dl:renraku",
		"nomen": "node x/core/nomen/examples.js",
		"_clean": "rm -rf x && mkdir x",
		"_tsc": "tsc",
		"_scute": "scute -v",
		"_ln": "run-s _ln:s",
		"_ln:s": "ln -s \"$(realpath s)\" x/s",
		"_dl:slate": "rm -rf node_modules/@benev/slate && ln -s \"$(realpath ../../@benev/slate)\" node_modules/@benev/slate",
		"_dl:turtle": "rm -rf node_modules/@benev/turtle && ln -s \"$(realpath ../../@benev/turtle)\" node_modules/@benev/turtle",
		"_dl:renraku": "rm -rf node_modules/renraku && ln -s \"$(realpath ../../chase-moskal/renraku)\" node_modules/renraku"
	},
	"author": "Chase Moskal <chasemoskal@gmail.com>",
	"homepage": "https://github.com/e280/authlocal#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/e280/authlocal.git"
	},
	"bugs": {
		"url": "https://github.com/e280/authlocal/issues"
	},
	"keywords": [
		"auth",
		"authentication",
		"zero-cost",
		"privacy-focused",
		"user-sovereign",
		"clientside",
		"federated",
		"decentralized",
		"protocol",
		"free",
		"open-source"
	]
}
