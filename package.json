{
	"name": "@e280/authlocal",
	"version": "0.3.0-0",
	"description": "user-sovereign login system for everybody",
	"license": "MIT",
	"main": "./x/index.js",
	"type": "module",
	"files": [
		"x",
		"s"
	],
	"exports": {
		".": "./x/index.js",
		"./core": "./x/core/index.js",
		"./core/alco": "./x/core/alco/index.js",
		"./core/cryp": "./x/core/cryp/index.js",
		"./core/nomen": "./x/core/nomen/index.js",
		"./core/tok": "./x/core/tok/index.js"
	},
	"scripts": {
		"build": "rm -rf x && mkdir x && tsc && ln -s '$(realpath s)' x/s && scute -v",
		"start": "octo 'tsc -w' 'scute -vw' 'node --watch x/test.js' 'sleep 1; hottie x'",
		"test": "node x/test.js",
		"count": "find s -path '*/_archive' -prune -o -name '*.ts' -exec wc -l {} +",
		"nomen": "node x/core/nomen/examples.js"
	},
	"dependencies": {
		"@e280/kv": "^0.1.0",
		"@e280/renraku": "^0.5.6",
		"@e280/sly": "^0.3.0-8",
		"@e280/strata": "^0.3.0-1",
		"@e280/stz": "^0.2.24",
		"@noble/ciphers": "^2.1.1",
		"@noble/curves": "^2.0.1",
		"@noble/ed25519": "^3.0.0",
		"@noble/hashes": "^2.0.1",
		"lit": "^3.3.2"
	},
	"devDependencies": {
		"@e280/hottie": "^0.1.0-3",
		"@e280/octo": "^0.1.0-12",
		"@e280/science": "^0.1.8",
		"@e280/scute": "^0.3.0-1",
		"http-server": "^14.1.1",
		"npm-run-all": "^4.1.5",
		"typescript": "^5.9.3"
	},
	"author": "Chase Moskal <chasemoskal@gmail.com>",
	"homepage": "https://github.com/e280/authlocal#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/e280/authlocal.git"
	},
	"bugs": {
		"url": "https://github.com/e280/authlocal/issues"
	},
	"keywords": [
		"auth",
		"authentication",
		"zero-cost",
		"privacy-focused",
		"user-sovereign",
		"clientside",
		"federated",
		"decentralized",
		"protocol",
		"free",
		"open-source"
	]
}
